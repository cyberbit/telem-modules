{
  "schemaVersion": "1",
  "id": "telem-modules",
  "name": "cyberbit's Telem Modules",
  "description": "First-party Telem modules for Mekanism, Advanced Peripherals, and more",
  "modules": [
    {
      "id": "powah",
      "name": "Powah",
      "description": "Provides inputs for Powah devices when the Advanced Peripherals mod is installed.",
      "version": "0.1.0",
      "documentation": "HELP.md#powah",
      "requirements": {
        "advancedperipherals": "^0.7.25",
        "powah": "*"
      },
      "provides": {
        "inputs": [
          "energyCell",
          "furnator",
          "magmator",
          "reactor",
          "solarPanel",
          "thermoGenerator"
        ]
      },
      "artifacts": {
        "source": {
          "type": "source-tree",
          "location": "src/telem/modules/powah",
          "entrypoint": "init.lua"
        },
        "lua": {
          "type": "lua",
          "location": "$release/powah.lua"
        },
        "luz": {
          "type": "luz",
          "location": "$release/powah.luz"
        }
      }
    },
    {
      "id": "advancedPeripherals",
      "name": "Advanced Peripherals",
      "description": "Provides inputs for Advanced Peripherals devices, including storage support for Applied Energistics and Refined Storage",
      "version": "0.1.0",
      "documentation": "HELP.md#advanced-peripherals",
      "requirements": {
        "advancedperipherals": "^0.7.25"
      },
      "provides": {
        "inputs": [
          "energyDetector",
          "environmentDetector",
          "geoScanner",
          "inventoryManager",
          "meBridge",
          "playerDetector",
          "redstoneIntegrator",
          "rsBridge"
        ]
      },
      "artifacts": {
        "source": {
          "type": "source-tree",
          "location": "src/telem/modules/advancedPeripherals",
          "entrypoint": "init.lua"
        },
        "lua": {
          "type": "lua",
          "location": "$release/advancedPeripherals.lua"
        },
        "luz": {
          "type": "luz",
          "location": "$release/advancedPeripherals.luz"
        }
      }
    },
    {
      "id": "biggerReactors",
      "name": "Bigger Reactors",
      "description": "Provides inputs for Bigger Reactors machines",
      "version": "0.1.0",
      "documentation": "HELP.md#bigger-reactors",
